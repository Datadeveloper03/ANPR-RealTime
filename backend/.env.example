# Supabase PostgreSQL Connection String (Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres)
# If left as sqlite:///./anpr_local.db, it runs locally without external credentials.
DATABASE_URL=sqlite:///./anpr_local.db

# Redis Connection URL (Format: redis://default:[YOUR-REDIS-PASS]@[HOST]:[PORT])
# If Redis is unavailable, the backend automatically uses an in-memory PubSub fallback.
REDIS_URL=redis://localhost:6379/0

# Anomaly detection settings
MAX_PLAUSIBLE_SPEED_KMH=140.0
